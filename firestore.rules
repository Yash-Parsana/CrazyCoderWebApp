rules_version = '2';

// Draft rules based on the data model both clients use today: this repo's
// web app (src/services/firebaseService.js) AND the Android app
// (CrazyCoderApp/app/src/main/java/.../{SignIn,SignUp,Fragment/chatFragment}.kt)
// share the same Firebase project, and both were checked against these
// rules before writing them. NOT deployed by anything in this repo -
// review, adjust, and deploy yourself via the Firebase console or:
//   firebase deploy --only firestore:rules
// This is the one place real access control has to live: nothing in
// either client's bundle/APK can be trusted as a security boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: { email, status, username, chatfriends, pic }
    // PLUS a special users/userNameToId doc (Android only) holding a flat
    // { username: uid } map used for username lookups there - the web app
    // instead does a `where('username','==',...)` query, so the two
    // clients use different mechanisms for the same lookup and don't
    // populate each other's index (a pre-existing inconsistency, not
    // introduced by these rules - a web-app signup never gets added to
    // userNameToId, so Android users can't "add friend by username" a
    // web-only user today).
    match /users/{uid} {
      // Read is open on purpose: SignUpForm/SignUp.kt check username
      // availability BEFORE the visitor is signed in, and both apps look
      // up friends by username too. If you don't need email readable by
      // everyone, consider moving username lookups to a separate
      // "usernames" collection that only maps username -> uid.
      allow read: if true;
      allow write: if request.auth != null && (
        // the owner may write anything on their own doc
        request.auth.uid == uid ||
        // both apps' "add friend" flow writes the OTHER user's chatfriends
        // array directly (Chat.jsx addFriend / chatFragment.kt) with no
        // backend in between - so a non-owner write is allowed, but only
        // if chatfriends is the one field being touched. This can't stop
        // someone from tampering with another user's friend list, but it
        // keeps a non-owner write from touching username/email/pic/status.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatfriends']) ||
        // the shared username index doc: any signed-in user can write it
        // (both apps do, to register their own username). Firestore rules
        // can't express "only add a new key whose value is your own uid,
        // never touch existing keys" without knowing the key name up
        // front, so this is intentionally left open for any authenticated
        // user - the residual risk is someone overwriting another user's
        // entry to redirect "find by username" to their own uid (not an
        // account takeover, since it doesn't grant access to the other
        // user's actual data). Tighten this by moving to a
        // usernames/{username} collection with immutable-once-created
        // rules if that residual risk matters to you - that needs an app
        // code change on both platforms, so flagging rather than doing it.
        uid == 'userNameToId'
      );
    }

    // handles/{uid}: { myhandles: {...}, friendshandles: {...} }
    match /handles/{uid} {
      // Read stays open for the same reason as above: LeaderBoard reads a
      // user's own handles doc to show friends' ranks.
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // chat/{room}/{room}/{messageId}, where `room` is `uidA + uidB`
    // (two Firebase Auth uids concatenated with no separator, both orders
    // used - see Chat.jsx senderRoom/receiverRoom). Since uids aren't
    // split out into their own path segments, this is the best rule that
    // can be written for the current schema; consider switching to a
    // delimited/sorted room id (e.g. `${[uidA,uidB].sort().join('_')}`) as
    // a follow-up so this can be tightened to an exact two-participant
    // check instead of a substring match.
    match /chat/{room}/{roomAgain}/{messageId} {
      allow read, write: if request.auth != null &&
        (room.matches('^' + request.auth.uid + '.*') || room.matches('.*' + request.auth.uid + '$'));
    }
  }
}
