rules_version = '2';

// Draft rules for Storage, matching src/services/firebaseService.js's
// uploadImage(file, filename) which writes to images/{uid} (profile
// avatars). NOT deployed by anything in this repo - review and deploy
// yourself via the Firebase console or:
//   firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{uid} {
      // Avatars are shown to other users (friend lists, chat), so read stays public.
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
